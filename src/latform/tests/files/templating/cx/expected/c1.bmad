! minimal cx line (synthetic test fixture)
no_digested
C1_LINE_ROT = 0
C1_BEN0: sbend, L=0.5, ref_tilt=C1_LINE_ROT
C1_BEN1: C1_BEN0, type=BEND_TYPE_A
O_C1_BEN: overlay = {C1_BEN1[g]:g}, var={g}
C1_QUA1: quadrupole, L=0.3
C1_PIP5: pipe, L=1.0
C1_PIP5[L] = 6.5
C1: line = (C1_BEN1, C1_QUA1, C1_PIP5)
call, file=c1.bpm.bmad
call, file=c1.cor.bmad
call, file=c1.col.bmad
call, file=settings/settings.bmad
